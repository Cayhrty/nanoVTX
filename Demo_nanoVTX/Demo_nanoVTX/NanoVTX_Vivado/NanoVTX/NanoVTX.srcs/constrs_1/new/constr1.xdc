set_load 2.000 [all_outputs]
set_operating_conditions -board_layers 4to7
set_operating_conditions -board small
set_operating_conditions -heatsink low
create_clock -period 16.276 -name data_clk -waveform {0.000 8.138} [get_ports data_clk]
set_output_delay -clock [get_clocks data_clk] -min -add_delay -3.000 [get_ports {P0[*]}]
set_output_delay -clock [get_clocks data_clk] -max -add_delay 5.000 [get_ports {P0[*]}]
set_output_delay -clock [get_clocks data_clk] -min -add_delay -3.000 [get_ports {P1[*]}]
set_output_delay -clock [get_clocks data_clk] -max -add_delay 5.000 [get_ports {P1[*]}]
set_clock_groups -asynchronous -group [get_clocks clk_fpga_0] -group [get_clocks data_clk]
set_property C_CLK_INPUT_FREQ_HZ 300000000 [get_debug_cores dbg_hub]
set_property C_ENABLE_CLK_DIVIDER false [get_debug_cores dbg_hub]
set_property C_USER_SCAN_CHAIN 1 [get_debug_cores dbg_hub]
connect_debug_port dbg_hub/clk [get_nets clk]


